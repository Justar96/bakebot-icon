{
  "name": "gisx-icon-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The gisx mascot: a headless character package and its React binding.",
  "workspaces": {
    "packages": ["packages/*", "apps/*"],
    "catalog": {
      "@types/bun": "^1.3.14",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '@gisx-icon/core' build && bun run --filter 'gisx-icon' build",
    "play": "bun run --filter '@gisx-icon/playground' dev",
    "verify:tarballs": "bun scripts/verify-tarballs.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
