{
  "name": "@bakebot/core",
  "version": "0.4.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "The bakebot mascot's character: a headless spring simulation with no renderer.",
  "keywords": [
    "bakebot",
    "mascot",
    "spring",
    "physics",
    "headless",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bakebot-icon.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Justar96/bakebot-icon",
  "bugs": {
    "url": "https://github.com/Justar96/bakebot-icon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
